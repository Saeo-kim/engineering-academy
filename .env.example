# Copy to .env and adjust. .env is ignored by Git; never commit real values.
# Every variable is optional. With none set, the app runs on http://localhost:4310,
# reachable only from this computer, with no password.

# Port to listen on.
PORT=4310

# SQLite file. Defaults to data/academy.db.
# ACADEMY_DB=data/academy.db

# Interface to bind. Keep 127.0.0.1 unless a reverse proxy or tunnel on another
# machine must reach the app. Anything else requires ACADEMY_PASSWORD.
# HOST=127.0.0.1

# Required (12+ characters) whenever HOST or ACADEMY_ALLOWED_HOSTS exposes the app.
# ACADEMY_PASSWORD=

# Extra Host headers to accept, comma separated. "*.example.com" matches subdomains.
# Needed behind a tunnel or proxy, e.g. *.trycloudflare.com
# ACADEMY_ALLOWED_HOSTS=

# Sign sessions with a fixed key so sign-ins survive restarts (random otherwise).
# ACADEMY_SESSION_SECRET=

# Trust X-Forwarded-Proto / CF-Connecting-IP from a proxy in front of the app,
# for Secure cookies and per-client login rate limiting.
# ACADEMY_TRUST_PROXY=true

# Always mark the session cookie Secure (when served only over HTTPS).
# ACADEMY_SECURE_COOKIES=true

# Add example records on first run of a new database (default true).
# ACADEMY_SEED=true

# Answer evaluator for explain-back and rebuild exercises. Only "local" ships
# today; see server/evaluator.js for how to plug in an AI provider.
# ACADEMY_EVALUATOR=local
